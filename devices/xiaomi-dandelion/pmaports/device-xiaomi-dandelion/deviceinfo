# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.
#
# BOZZA 2026-11-09, mai compilata né avviata. Valori da raw/bootimg-analyze.txt.

deviceinfo_format_version="0"
deviceinfo_name="Xiaomi Redmi 9A / 9AT"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-dandelion"
deviceinfo_year="2020"
# Da verificare: nome del dtb base prodotto dal kernel dandelion-q-oss
deviceinfo_dtb="mediatek/mt6765"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1600"

# Il kernel 4.9 sa decomprimere solo gzip (CONFIG_RD_GZIP): con zstd non parte l'initramfs
deviceinfo_initfs_compression="gzip"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"
deviceinfo_flash_fastboot_partition_dtbo="dtbo"
deviceinfo_bootimg_mtk_mkimage="false"
deviceinfo_flash_pagesize="2048"
deviceinfo_header_version="2"
# Il kernel esce già come Image.gz-dtb: boot-deploy non deve accodare un secondo dtb.
# Il file in /boot/dtbs è la tabella Android DT per la sezione dtb, come nello stock.
deviceinfo_append_dtb="false"
deviceinfo_flash_offset_base="0x40078000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x11a88000"
deviceinfo_flash_offset_second="0x00e88000"
deviceinfo_flash_offset_tags="0x07808000"
deviceinfo_flash_offset_dtb="0x07808000"
