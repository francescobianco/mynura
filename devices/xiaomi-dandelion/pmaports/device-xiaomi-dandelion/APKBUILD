# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-dandelion
pkgdesc="Xiaomi Redmi 9A / 9AT"
pkgver=1
pkgrel=7
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-xiaomi-dandelion
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	xorg.conf
	dandelion-sxmo.sh
	sxmo-deviceprofile.sh
	sxmo_autosuspend.service
	upower-dandelion.conf
	focaltech_ts_fw_helitai.bin
	30-touch-firmware.files
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/xorg.conf \
		"$pkgdir"/etc/X11/xorg.conf.d/10-dandelion.conf
	install -Dm644 "$srcdir"/dandelion-sxmo.sh \
		"$pkgdir"/etc/profile.d/dandelion-sxmo.sh
	install -Dm755 "$srcdir"/sxmo-deviceprofile.sh \
		"$pkgdir"/usr/bin/sxmo_deviceprofile_mediatek,MT6765.sh
	install -Dm644 "$srcdir"/sxmo_autosuspend.service \
		"$pkgdir"/etc/superd/services/sxmo_autosuspend.service
	install -Dm644 "$srcdir"/upower-dandelion.conf \
		"$pkgdir"/etc/UPower/UPower.conf.d/90-dandelion.conf
	# Firmware del touch FT8006S-AA, estratto dalla partizione vendor del telefono
	install -Dm644 "$srcdir"/focaltech_ts_fw_helitai.bin \
		"$pkgdir"/lib/firmware/focaltech_ts_fw_helitai.bin
	# Il driver lo chiede a 2 s dall'avvio: deve stare anche nell'initramfs
	install -Dm644 "$srcdir"/30-touch-firmware.files \
		-t "$pkgdir"/usr/share/mkinitfs/files
}
