# init.rc minimo del contenitore modem di Nura: solo NVRAM e modem.
on early-init
    mkdir /dev/socket 0755 root root

    # Gruppi di processi che i servizi Android si aspettano (dall'init.rc di sistema)
    mkdir /dev/cpuset/foreground
    copy /dev/cpuset/cpus /dev/cpuset/foreground/cpus
    copy /dev/cpuset/mems /dev/cpuset/foreground/mems
    mkdir /dev/cpuset/background
    copy /dev/cpuset/cpus /dev/cpuset/background/cpus
    copy /dev/cpuset/mems /dev/cpuset/background/mems
    mkdir /dev/cpuset/system-background
    copy /dev/cpuset/cpus /dev/cpuset/system-background/cpus
    copy /dev/cpuset/mems /dev/cpuset/system-background/mems
    mkdir /dev/cpuset/top-app
    copy /dev/cpuset/cpus /dev/cpuset/top-app/cpus
    copy /dev/cpuset/mems /dev/cpuset/top-app/mems
    mkdir /dev/cpuset/restricted
    copy /dev/cpuset/cpus /dev/cpuset/restricted/cpus
    copy /dev/cpuset/mems /dev/cpuset/restricted/mems
    mkdir /dev/stune/foreground
    mkdir /dev/stune/background
    mkdir /dev/stune/top-app
    mkdir /dev/stune/rt

on late-init
    trigger post-fs-data
    trigger boot

on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/ccci_cfg 0770 system radio
    mkdir /data/vendor/mdlpm 0770 system radio
    mkdir /data/vendor/md3 0770 system radio
    mkdir /data/vendor/nvram 0771 root system
    mkdir /data/vendor/audiohal 0771 system audio
    mkdir /data/local/tmp 0771 shell shell
    mkdir /mnt/vendor/nvdata/md 0770 root system
    chown radio radio /sys/kernel/ccci/boot
    chmod 0660 /dev/ccci_fs
    chmod 0666 /dev/binder
    chmod 0666 /dev/hwbinder
    chmod 0666 /dev/vndbinder

on boot
    start logd
    start nvram_daemon
    start vendor.ccci_fsd
    start vendor.ccci_rpcd
    # Per l'HAL audio MediaTek (modem/audio/mtkaudio): senza hwservicemanager resta in attesa
    start servicemanager
    start hwservicemanager
    start vndservicemanager
    # Da init.md_apps.rc di MIUI: versione del firmware del modem
    setprop ro.vendor.md_apps.support 1
    setprop ro.vendor.md_apps.load_type user
    setprop ro.vendor.md_apps.load_verno "MOLY.LR12A.R3.MP.V107.5.P101"
    setprop ro.vendor.md_apps.load_gencfg "GEN93_USER"

on property:vendor.service.nvram_init=Ready
    start ccci_mdinit

service nvram_daemon /vendor/bin/nvram_daemon
    user root
    group system radio
    oneshot
    disabled
    seclabel u:r:init:s0

service vendor.ccci_fsd /vendor/bin/ccci_fsd 0
    user radio
    group radio system root
    oneshot
    disabled
    seclabel u:r:init:s0

# Il modem chiede ad Android dati dell'hardware (GPIO, ADC, indice RF) via RPC
service vendor.ccci_rpcd /vendor/bin/ccci_rpcd 0
    user radio
    group radio system
    oneshot
    disabled
    seclabel u:r:init:s0

service ccci_mdinit /vendor/bin/ccci_mdinit 0
    user system
    group radio system
    oneshot
    disabled
    seclabel u:r:init:s0

# Log di Android, per leggere ccci_fsd e nvram_daemon con logcat.
# Senza "file /proc/kmsg": toglierebbe i messaggi del kernel al registro di Nura.
service logd /system/bin/logd
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram+passcred 0222 logd logd
    file /dev/kmsg w
    user logd
    group logd system package_info readproc
    capabilities SYSLOG AUDIT_CONTROL SETGID
    disabled

# Gestori dei servizi Android (binder, hwbinder, vndbinder), per l'HAL audio
service servicemanager /system/bin/servicemanager
    user system
    group system readproc
    disabled
    seclabel u:r:init:s0

service hwservicemanager /system/bin/hwservicemanager
    user system
    group system readproc
    disabled
    seclabel u:r:init:s0

service vndservicemanager /vendor/bin/vndservicemanager /dev/vndbinder
    user system
    group system readproc
    disabled
    seclabel u:r:init:s0
